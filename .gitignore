# ==============================================================================
# FixLoop - Root Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Sensitive Files
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
docker/.env
!docker/.env.example

# Private Keys, Certificates & Keystores
*.pem
*.key
*.cert
*.crt
*.p12
*.jks
*.keystore
*.pk8
*.der
*.asc
id_rsa*
id_ed25519*
.ssh/

# Cloud & Third-Party Service Credentials
google-services.json
*firebase*.json
*service-account*.json
credentials.json
client_secret*.json

# ------------------------------------------------------------------------------
# 2. Local Machine, Device & User Specific Settings
# ------------------------------------------------------------------------------
local.properties
**/local.properties
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.history/
*.swp
*.swo
*~
*.orig
*.rej
*.bak

# AI Assistant & Tool Caches / Configs
.gemini/
.cursor/
.claude/
.antigravity/

# ------------------------------------------------------------------------------
# 3. Documentation, Internal Specs, Blueprints & Plans
# (Only the root README.md is tracked for public push)
# ------------------------------------------------------------------------------
docs/
*.md
*.MD
*.markdown
*.mdown
*.mkd
*.mkdn
!/README.md
!/README.MD

# Plans, Blueprints & Notes
plan/
plans/
*.plan
*.drawio.bkp

# ------------------------------------------------------------------------------
# 4. Private / Prototype Demos
# ------------------------------------------------------------------------------
demo app fixloop/

# ------------------------------------------------------------------------------
# 5. Build Artifacts & Dependencies
# ------------------------------------------------------------------------------
# Node.js (Web Frontend)
node_modules/
web/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp/
.pnp.js
build/
web/build/
dist/

# Java / Maven (Backend)
backend/target/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Android / Gradle (Mobile)
.gradle/
mobile/.gradle/
mobile/build/
mobile/app/build/
*.apk
*.ap_
*.aab
.cxx/
mobile/.cxx/
mobile/app/.cxx/
captures/
mobile/captures/
.externalNativeBuild/
mobile/.externalNativeBuild/
mobile/app/.externalNativeBuild/
.kotlin/
mobile/.kotlin/

# Python & Runtime Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/

# Uploads & Temp Runtime Storage
uploads/
**/uploads/
temp/
tmp/
*.tmp

# Logs
*.log
logs/
